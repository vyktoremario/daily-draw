# Copy to .env and adjust. Local values only — never put production secrets here.
DATABASE_URL=postgres://dailydraw:dailydraw@localhost:5432/dailydraw
REDIS_URL=redis://localhost:6379
API_PORT=4000
USSD_PORT=4100
API_URL=http://localhost:4000
# Play money only in local and staging
MONEY_MODE=play

# ------------------------------------------------------------------------------------------------
# Public testnet (Base Sepolia): `pnpm testnet:deploy` and `pnpm keeper`. Step by step:
# docs/testnet-runbook.md. Testnet wallets only. Private keys live only here (.env is gitignored)
# and in GitHub secrets: never paste one into a chat, an issue or a commit.
# ------------------------------------------------------------------------------------------------
# JSON-RPC endpoint of the testnet. The public Base Sepolia one works; a provider URL
# (Alchemy, QuickNode, ...) is faster and has higher limits.
TESTNET_RPC_URL=https://sepolia.base.org
# Name of the deployment file (packages/contracts/deployments/<name>.json).
TESTNET_NETWORK=base-sepolia
# Deployer wallet's private key (MetaMask: account menu > Account details > Show private key).
# Pays the deployment gas, then holds no role.
DEPLOYER_PRIVATE_KEY=
# Keeper wallet's private key: closes draws and claims for winners. Also a GitHub secret.
KEEPER_PRIVATE_KEY=
# Admin wallet (address only): pauses, voids, proposes timelocked changes, owns the VRF adapter.
ADMIN_ADDRESS=0xECfeb88A1fFcce1d7dec2Dbc9Ef53dc4301D109f
# Admin wallet's private key. Only for timelocked setting changes from this computer
# (`pnpm testnet:set-fee`); leave empty otherwise, and empty it again when you're done.
ADMIN_PRIVATE_KEY=
# Keeper wallet (address only): gets KEEPER_ROLE.
KEEPER_ADDRESS=0x9032f538d36fD201D019d11361FDBb1EE72D1034
# Optional: where the team (10%) and buy-back (5%) shares go. Default: ADMIN_ADDRESS.
TREASURY_ADDRESS=
BUYBACK_ADDRESS=
# Chainlink VRF v2.5 subscription id (vrf.chain.link > your subscription > the full ID).
VRF_SUBSCRIPTION_ID=
# Optional VRF overrides. Coordinator and key hash default to Base Sepolia's
# (docs.chain.link/vrf/v2-5/supported-networks); set them for any other chain.
VRF_COORDINATOR=
VRF_KEY_HASH=
VRF_CALLBACK_GAS_LIMIT=500000
VRF_REQUEST_CONFIRMATIONS=3
# false: pay for randomness in LINK (the subscription holds LINK). true: in testnet ETH.
VRF_NATIVE_PAYMENT=false
# Seconds every params change or upgrade waits in the timelock. 1 hour on the testnet;
# 172800 (48 hours) on a mainnet.
TIMELOCK_DELAY=3600
# Optional: first cutoff as a unix time. Empty = the next 8:45pm WAT. Every later cutoff is
# exactly one day after the previous one, so leave it empty unless you know you need it.
FIRST_CUTOFF=
# Optional: comma-separated wallets that get $1,000 test USDC at deployment.
SEED_WALLETS=
# Etherscan API key (etherscan.io > API Keys); one key verifies on BaseScan too.
ETHERSCAN_API_KEY=
# WalletConnect / Reown project id for the web app (set it in Vercel; listed here for reference).
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
