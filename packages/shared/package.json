{
  "name": "@daily-draw/shared",
  "version": "0.0.0",
  "private": true,
  "description": "Game rules, money, settlement and draw verification. Pure functions, no I/O: runs in API, worker and browser.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "test-vectors"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "vectors": "tsx scripts/generate-vectors.ts"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0"
  },
  "devDependencies": {
    "@daily-draw/config": "workspace:*",
    "tsx": "^4.23.15"
  }
}
