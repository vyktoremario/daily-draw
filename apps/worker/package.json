{
  "name": "@daily-draw/worker",
  "version": "0.0.0",
  "private": true,
  "description": "Background jobs: cutoff, draw, settlement, payouts, outbox (pg-boss)",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@daily-draw/db": "workspace:*",
    "@daily-draw/shared": "workspace:*",
    "pg-boss": "^12.39.0"
  },
  "devDependencies": {
    "@daily-draw/config": "workspace:*",
    "tsx": "^4.23.15"
  }
}
