# Admin dashboard settings. Copy to apps/admin/.env.local for local runs; set the same names in
# the Vercel project. Server-side only (no NEXT_PUBLIC_): none of this reaches the browser.

# Basic auth. Required on Vercel (the dashboard answers 503 without them); optional in `next dev`.
ADMIN_USER=
ADMIN_PASSWORD=

# Deployment file in packages/contracts/deployments/ that supplies the defaults below
# (chain, contract addresses, start block, keeper, VRF coordinator and subscription).
# "none" to set everything by hand.
DEPLOYMENT=base-sepolia

# Optional overrides. Leave empty to use the deployment file's values.
# CHAIN_ID=84532
# Must allow eth_getLogs over long block ranges. Default on Base Sepolia: the Tenderly gateway.
# RPC_URL=https://base-sepolia.gateway.tenderly.co
# DAILY_DRAW_ADDRESS=
# USDC_ADDRESS=
# TIMELOCK_ADDRESS=
# START_BLOCK=
# KEEPER_ADDRESS=
# VRF_COORDINATOR=
# VRF_SUBSCRIPTION_ID=
# Largest block range per eth_getLogs request (halved automatically if the RPC refuses).
# LOG_CHUNK_BLOCKS=1000000

# Gas drip wallet (#46): shown with a low-balance warning when set.
DRIP_WALLET_ADDRESS=

# Warning thresholds (defaults shown).
# KEEPER_MIN_ETH=0.005
# DRIP_MIN_ETH=0.02
# VRF_MIN_LINK=5
# VRF_MIN_NATIVE=0.01
# CLOSE_GRACE_MINUTES=45
# RANDOMNESS_GRACE_MINUTES=30
# SWEEP_WARN_DAYS=7
