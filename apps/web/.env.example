# Player app settings. `pnpm dev:chain` writes apps/web/.env.local for the local Anvil chain;
# copy this file to .env.local for a testnet. NEXT_PUBLIC_* values end up in the browser bundle:
# addresses and ids only, never secrets.

# anvil | baseSepolia | celoSepolia | base | celo (add more in apps/web/lib/config.ts)
NEXT_PUBLIC_CHAIN=anvil
# Optional: the chain's public RPC is used when empty.
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545
# DailyDraw proxy and the USDC it takes.
NEXT_PUBLIC_DAILY_DRAW_ADDRESS=
NEXT_PUBLIC_USDC_ADDRESS=
# Deployment block, where event scans (tickets, referrals) start.
NEXT_PUBLIC_START_BLOCK=0
# Test USDC faucet button (testnets only; always off on mainnets).
NEXT_PUBLIC_FAUCET=true
# Anvil's unlocked accounts as "Dev wallet" choices (anvil only).
NEXT_PUBLIC_DEV_WALLETS=true
# WalletConnect / Reown project id. Leave empty to offer browser wallets only.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
