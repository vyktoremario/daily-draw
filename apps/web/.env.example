# Player app settings. `pnpm dev:chain` writes apps/web/.env.local for the local Anvil chain;
# copy this file to .env.local for a testnet. NEXT_PUBLIC_* values end up in the browser bundle:
# addresses and ids only, never secrets.

# anvil | baseSepolia | celoSepolia | base | celo (add more in apps/web/lib/config.ts)
NEXT_PUBLIC_CHAIN=anvil
# Optional: the chain's public RPC is used when empty.
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545
# DailyDraw proxy and the USDC it takes.
NEXT_PUBLIC_DAILY_DRAW_ADDRESS=
NEXT_PUBLIC_USDC_ADDRESS=
# Deployment block, where event scans (tickets, referrals) start.
NEXT_PUBLIC_START_BLOCK=0
# Test USDC faucet button (testnets only; always off on mainnets).
NEXT_PUBLIC_FAUCET=true
# Anvil's unlocked accounts as "Dev wallet" choices (anvil only).
NEXT_PUBLIC_DEV_WALLETS=true
# WalletConnect / Reown project id. Leave empty to offer browser wallets only.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# --- Gas drip (testnets only): POST /api/drip sends new wallets a little test ETH for fees. ---
# Server-side only (no NEXT_PUBLIC_ prefix): never shipped to the browser. Set them in Vercel
# (Settings -> Environment Variables), not in a committed file. Without the key or the Redis
# store the drip stays off and players are told to ask for test ETH instead.
# Private key of a dedicated testnet-only drip wallet (not the Deployer, Keeper or Admin).
DRIP_PRIVATE_KEY=
# Upstash Redis REST endpoint (remembers dripped addresses and the daily total). Vercel's
# Upstash integration sets KV_REST_API_URL / KV_REST_API_TOKEN; UPSTASH_REDIS_REST_URL /
# UPSTASH_REDIS_REST_TOKEN also work.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Optional limits (defaults shown).
DRIP_AMOUNT_ETH=0.0005
DRIP_MIN_BALANCE_ETH=0.0001
DRIP_DAILY_CAP_ETH=0.01
DRIP_PER_IP_DAILY=5
# Optional: RPC for the drip's own reads and sends (defaults to NEXT_PUBLIC_RPC_URL).
DRIP_RPC_URL=

# --- Blocked countries (server-side, read by proxy.ts on every request). ---
# Visitors from these countries see only "Not available in your country". Country codes
# (ISO 3166-1, e.g. IR) or country-region codes (e.g. UA-43 for Crimea), comma separated.
# Empty = the PLACEHOLDER list in apps/web/lib/geo.ts until the lawyer's list is agreed;
# `none` = block nobody. Locally there is no country header, so nobody is blocked.
BLOCKED_COUNTRIES=
